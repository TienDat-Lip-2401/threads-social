{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowOrigins": [
    "http://localhost:3000",
    "http://localhost:5173",
    "https://your-domain-fe.com"
  ],
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Key": "",
    "Issuer": "https://localhost:7066",
    "Audience": "Pharse2Users",
    "ExpireMinutes": 30,
    "RefreshToken": {
      "ExpireDays": 7
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Pharse2": "Information",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
