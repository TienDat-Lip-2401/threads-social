# Copy thành .env (đã được .gitignore) rồi đổi giá trị trước khi chạy `docker compose up`.

# Mật khẩu tài khoản sa của SQL Server trong Docker.
# Yêu cầu: >= 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# Khóa ký JWT: chuỗi ngẫu nhiên >= 32 ký tự.
# PowerShell: [Convert]::ToBase64String((1..64 | % { Get-Random -Max 256 }))
JWT_KEY=change-me-to-a-random-string-at-least-32-chars

# Cổng trên máy để gọi API (http://localhost:5080/api/).
API_PORT=5080

# Development: bật Swagger. Đổi thành Production khi deploy thật.
ASPNETCORE_ENVIRONMENT=Development

# Địa chỉ FE, dùng để tạo link trong email (đặt lại mật khẩu, xác thực email).
FRONTEND_BASE_URL=http://localhost:5173

# ---- Email (SMTP) ----
# Để trống/comment cả mục này → email được Mailpit hứng lại, xem tại http://localhost:8025 (không gửi thật).
# Gửi email thật bằng Gmail:
#   1. Bật xác minh 2 bước cho tài khoản Google
#   2. Tạo App Password tại https://myaccount.google.com/apppasswords (16 ký tự)
#   3. Bỏ comment và điền các dòng dưới (KHÔNG commit file .env)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_ENABLE_SSL=true
# SMTP_USERNAME=your-account@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=your-account@gmail.com
# SMTP_FROM_NAME=Threads
