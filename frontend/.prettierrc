{
    "arrowParens": "always",
    "semi": true,
    "trailingComma": "all",
    "tabWidth": 4,
    "endOfLine": "auto",
    "useTabs": false,
    "singleQuote": true,
    "printWidth": 80,
    "jsxSingleQuote": true,
    "breakLongMethodChains": true,
    "plugins": ["prettier-plugin-tailwindcss"]
}
