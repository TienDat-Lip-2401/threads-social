{
    "compilerOptions": {
        "baseUrl": "./",
        "paths": {
            "@/*": ["src/*"],
            "@/styles/*": ["src/styles/*"],
            "@/router/*": ["src/router/*"],
            "@/layouts/*": ["src/layouts/*"],
            "@/pages/*": ["src/pages/*"],
            "@/assets/*": ["src/assets/*"],
            "@/components/*": ["src/components/*"],
            "@/libs/*": ["src/libs/*"],
            "@/hooks/*": ["src/hooks/*"],
            "@/context/*": ["src/context/*"],
            "@/redux/*": ["src/redux/*"],
            "@/services/*": ["src/services/*"],
            "@/utils/*": ["src/utils/*"],
            "@/locales/*": ["src/locales/*"],
            "@/store/*": ["src/store/*"]
        }
    }
}
